# Copy to .env: `cp .env.example .env`
# Matches the Postgres service in docker-compose.yml (host port 5433).
# Integration tests use the same server with database `mailbox_orders_test`
# (created automatically); override with TEST_DATABASE_URL if needed.
DATABASE_URL="postgresql://mailbox:mailbox@localhost:5433/mailbox_orders?schema=public"

# Signs the session JWT (HS256). Use any long random string, e.g. `openssl rand -base64 32`.
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Worker: how often an idle worker polls for PENDING orders.
WORKER_POLL_MS=1000

# Mock providers: per-mailbox failure probability and call latency.
# Use PROVIDER_FAILURE_RATE=0.5 for demos to see a failure reliably.
PROVIDER_FAILURE_RATE=0.2
PROVIDER_MIN_DELAY_MS=1000
PROVIDER_MAX_DELAY_MS=3000
